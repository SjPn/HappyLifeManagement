# Runtime (Vercel/serverless): Neon *pooler* URL is OK
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Migrations (prisma migrate): Neon *direct* URL (no "-pooler" in host)
# Locally you can set the same value as DATABASE_URL if you use direct only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="replace-with-random-string"
# Має збігатися з тим, що в адресному рядку браузера (схема + хост + порт), інакше Auth.js дає ClientFetchError на /api/auth/session
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
INVITE_CODE="HAPPY2026"

# Cloudflare R2 (обязательно на Vercel для фото)
# Endpoint — только хост, без /hems в конце (bucket задаётся отдельно)
R2_ACCOUNT_ID="7c67ace00d46893e1169b8d9b5c13080"
R2_ENDPOINT="https://7c67ace00d46893e1169b8d9b5c13080.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="hems"
# R2 → bucket hems → Settings → Public access
R2_PUBLIC_BASE_URL="https://pub-645a82c152174d118e6d5c53b6770b39.r2.dev"

# APK для кнопки «Скачать приложение» (после сборки: npm run upload:apk)
# NEXT_PUBLIC_APK_URL="https://pub-....r2.dev/releases/happylife.apk"

# Firebase Cloud Messaging (push в APK) — JSON сервисного аккаунта одной строкой
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...",...}'
# Публичный URL сайта для deep link в push (обычно = прод)
# NEXT_PUBLIC_APP_URL="https://hlm-nu.vercel.app"
# Native push in APK: only true after google-services.json is in mobile/android/app/
# NEXT_PUBLIC_ENABLE_NATIVE_PUSH=true
