generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Postgres: строковые коды; см. src/lib/enums.ts

model Community {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  inviteCode        String    @unique
  defaultLocale     String    @default("uk")
  memorandumBody    String?
  memorandumVersion String    @default("MVP-2026-05-05")
  tariffsBody              String?
  paymentRequisites        String?
  electricityDayRateUah    Float     @default(0)
  electricityNightRateUah  Float     @default(0)
  blockedAt         DateTime?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users              User[]
  addresses          CommunityAddress[]
  tickets            Ticket[]
  votes              Vote[]
  newsPosts          NewsPost[]
  boardPosts         BoardPost[]
  forumTopics        ForumTopic[]
  forumPosts         ForumPost[]
  reports            ConfidentialReport[]
  householdBillings           HouseholdBilling[]
  householdMeterReadings      HouseholdMeterReading[]
  householdBillingAuditLogs   HouseholdBillingAuditLog[]
  directMessages     DirectMessage[]
  documents          CommunityDocument[]
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?

  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  street      String
  houseNumber String

  communityAddressId String?
  communityAddress   CommunityAddress? @relation(fields: [communityAddressId], references: [id], onDelete: SetNull)

  role   String @default("RESIDENT") // RESIDENT | MODERATOR | CHAIR | PLATFORM_ADMIN
  status String @default("PENDING") // PENDING | APPROVED | REJECTED

  tenancyType String @default("OWNER")

  memorandumAcceptedAt DateTime?
  memorandumVersion    String?

  balanceUah Float @default(0)

  pushNotifyNewTickets   Boolean @default(true)
  pushNotifyTicketStatus Boolean @default(true)
  pushNotifyNews         Boolean @default(false)
  pushNotifyDebt         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pushTokens        DevicePushToken[]
  tickets           Ticket[]
  voteResponses     VoteResponse[]
  boardPosts        BoardPost[]
  forumTopics       ForumTopic[]
  forumPosts        ForumPost[]
  reportsAuthored   ConfidentialReport[] @relation("ReportAuthor")
  newsAuthored      NewsPost[]           @relation("NewsAuthor")
  newsLikes         NewsPostLike[]
  ticketComments    TicketComment[]
  seenState         UserSeenState?
  messagesSent      DirectMessage[]      @relation("SentMessages")
  messagesReceived  DirectMessage[]      @relation("ReceivedMessages")
  documentsUploaded CommunityDocument[]
}

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserSeenState {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsAt     DateTime @default(now())
  votesAt    DateTime @default(now())
  ticketsAt  DateTime @default(now())
  paymentsAt DateTime @default(now())
  boardAt    DateTime @default(now())
  forumAt    DateTime @default(now())
  reportsAt  DateTime @default(now())
  messagesAt DateTime @default(now())
}

model NewsPost {
  id          String         @id @default(cuid())
  communityId String
  community   Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  body        String
  imageUrl    String?
  authorId    String
  author      User           @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  likes       NewsPostLike[]
}

model NewsPostLike {
  id         String   @id @default(cuid())
  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, newsPostId])
  @@index([newsPostId])
}

model Ticket {
  id           String          @id @default(cuid())
  communityId  String
  community    Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category     String
  description  String
  photoUrl     String?
  locationNote String?
  status           String          @default("NEW")
  statusChangedAt  DateTime        @default(now())
  rating           Int?
  ratedAt          DateTime?
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  comments         TicketComment[]
}

model CommunityDocument {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([communityId])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @default("")
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Vote {
  id          String       @id @default(cuid())
  communityId String
  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String
  audience    String       @default("ALL")
  endsAt      DateTime?
  createdAt   DateTime     @default(now())
  options     VoteOption[]
  responses   VoteResponse[]
}

model VoteOption {
  id        String         @id @default(cuid())
  text      String
  sortOrder Int            @default(0)
  voteId    String
  vote      Vote           @relation(fields: [voteId], references: [id], onDelete: Cascade)
  responses VoteResponse[]
}

model VoteResponse {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteId    String
  vote      Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  optionId  String
  option    VoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, voteId])
}

model BoardPost {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category    String
  title       String
  body        String
  imageUrl    String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model ForumTopic {
  id          String      @id @default(cuid())
  communityId String
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  audience    String      @default("ALL")
  isAnonymous Boolean     @default(false)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  posts       ForumPost[]
}

model ForumPost {
  id          String     @id @default(cuid())
  communityId String
  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  body        String
  imageUrl    String?
  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

model CommunityAddress {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  street      String
  houseNumber String
  createdAt   DateTime  @default(now())

  users User[]

  @@unique([communityId, street, houseNumber])
}

model HouseholdBilling {
  id                 String    @id @default(cuid())
  communityId        String
  community          Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  street             String
  houseNumber        String
  periodYear         Int
  periodMonth        Int
  subscriptionFeeUah Float     @default(0)
  electricityUah     Float     @default(0)
  paidAt             DateTime?
  /// Когда голова надіслав мешканцю суми до сплати за період.
  paymentSentAt      DateTime?
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  @@unique([communityId, street, houseNumber, periodYear, periodMonth])
  @@index([communityId, street, houseNumber, periodYear, periodMonth])
}

/// Журнал змін нарахувань / оплати по дому (дії голови).
model HouseholdBillingAuditLog {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  street      String
  houseNumber String
  periodYear  Int
  periodMonth Int
  actorUserId String
  actorName   String
  action      String
  details     Json?
  createdAt   DateTime  @default(now())

  @@index([communityId, street, houseNumber, periodYear, periodMonth, createdAt])
}

/// Показания счётчика (накопительные) по дому за период.
model HouseholdMeterReading {
  id            String    @id @default(cuid())
  communityId   String
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  street        String
  houseNumber   String
  periodYear    Int
  periodMonth   Int
  dayReading    Float?
  nightReading  Float?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@unique([communityId, street, houseNumber, periodYear, periodMonth])
  @@index([communityId, periodYear, periodMonth])
}

model ConfidentialReport {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  kind        String
  category    String
  body        String
  photoUrl    String?
  published   Boolean   @default(false)
  authorId    String
  author      User      @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  status      String    @default("NEW")
  createdAt   DateTime  @default(now())
}

model DirectMessage {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([communityId, recipientId, createdAt])
  @@index([communityId, senderId, createdAt])
}
