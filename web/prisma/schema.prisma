generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Postgres: храним строковые коды; см. src/lib/enums.ts

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  phone        String?

  street      String
  houseNumber String

  communityAddressId String?
  communityAddress   CommunityAddress? @relation(fields: [communityAddressId], references: [id], onDelete: SetNull)

  role   String @default("RESIDENT") // RESIDENT | MODERATOR | CHAIR
  status String @default("PENDING") // PENDING | APPROVED | REJECTED

  /// OWNER | TENANT — з реєстрації; впливає на доступ до голосувань / тем за audience
  tenancyType String @default("OWNER")

  /// Consent to the resident memorandum (terms of community interaction)
  memorandumAcceptedAt DateTime?
  memorandumVersion    String?

  balanceUah Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets         Ticket[]
  voteResponses   VoteResponse[]
  boardPosts      BoardPost[]
  forumTopics     ForumTopic[]
  forumPosts      ForumPost[]
  reportsAuthored ConfidentialReport[] @relation("ReportAuthor")
  newsAuthored    NewsPost[]           @relation("NewsAuthor")
  seenState       UserSeenState?
}

/// Коли користувач останній раз відкривав розділ (для червоних лічильників «нове»)
model UserSeenState {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsAt     DateTime @default(now())
  votesAt    DateTime @default(now())
  ticketsAt  DateTime @default(now())
  paymentsAt DateTime @default(now())
  boardAt    DateTime @default(now())
  forumAt    DateTime @default(now())
  reportsAt  DateTime @default(now())
}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Ticket {
  id           String @id @default(cuid())
  category     String // TicketCategory
  description  String
  photoUrl     String?
  locationNote String?
  status       String @default("NEW") // TicketStatus
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vote {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String // YES_NO | SINGLE_CHOICE
  /// ALL | OWNERS_ONLY | TENANTS_ONLY — хто бачить і голосує
  audience    String    @default("ALL")
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  options     VoteOption[]
  responses   VoteResponse[]
}

model VoteOption {
  id        String @id @default(cuid())
  text      String
  sortOrder Int    @default(0)
  voteId    String
  vote      Vote   @relation(fields: [voteId], references: [id], onDelete: Cascade)
  responses VoteResponse[]
}

model VoteResponse {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteId    String
  vote      Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  optionId  String
  option    VoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, voteId])
}

model BoardPost {
  id        String   @id @default(cuid())
  category  String // BoardCategory
  title     String
  body      String
  imageUrl  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ForumTopic {
  id        String      @id @default(cuid())
  title     String
  /// ALL | OWNERS_ONLY | TENANTS_ONLY
  audience  String      @default("ALL")
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  posts     ForumPost[]
}

model ForumPost {
  id        String     @id @default(cuid())
  body      String
  imageUrl  String?
  topicId   String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}

/// Адреси домів у КГ — додає голова; житель обирає при реєстрації
model CommunityAddress {
  id          String   @id @default(cuid())
  street      String
  houseNumber String
  createdAt   DateTime @default(now())

  users User[]

  @@unique([street, houseNumber])
}

/// Нарахування за домоволодінням за календарний місяць (історія зберігається)
model HouseholdBilling {
  id                 String    @id @default(cuid())
  street             String
  houseNumber        String
  periodYear         Int
  periodMonth        Int
  subscriptionFeeUah Float     @default(0)
  electricityUah     Float     @default(0)
  /// Голова відмічає оплату за цей місяць
  paidAt             DateTime?
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  @@unique([street, houseNumber, periodYear, periodMonth])
  @@index([street, houseNumber, periodYear, periodMonth])
}

model ConfidentialReport {
  id        String   @id @default(cuid())
  kind      String // ReportKind
  category  String
  body      String
  photoUrl  String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  status    String   @default("NEW") // ReportStatus
  createdAt DateTime @default(now())
}

