# Runtime (Vercel/serverless): Neon *pooler* URL is OK
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Migrations (prisma migrate): Neon *direct* URL (no "-pooler" in host)
# Locally you can set the same value as DATABASE_URL if you use direct only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="replace-with-random-string"
# Має збігатися з тим, що в адресному рядку браузера (схема + хост + порт), інакше Auth.js дає ClientFetchError на /api/auth/session
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Код приглашения КГ для seed (не коммитить реальное значение)
INVITE_CODE=""
SEED_ADMIN_PASSWORD=""
SEED_CHAIR_PASSWORD=""
SEED_MOD_PASSWORD=""
SEED_RESIDENT_PASSWORD=""

# Публичное демо: кнопка «Попробовать демо» на главной и /login → /demo → вход без пароля.
# Выключить демо: DEMO_ENABLED=false
# Пароль хешируется в БД при seed; на Coolify (Runtime) — тот же DEMO_AUTO_LOGIN_PASSWORD, затем Redeploy
DEMO_ENABLED=true
DEMO_AUTO_LOGIN_PASSWORD=""

# --- npm run db:seed ---
# cd web → заполните .env → npm run db:seed → npm run seed:verify → npm run demo:verify
# Прод: те же DATABASE_URL, DIRECT_URL, INVITE_CODE, SEED_*_PASSWORD, DEMO_AUTO_LOGIN_PASSWORD
# Повторный seed обновляет хеши паролей тест-аккаунтов (admin@happylife.demo и др.)
# Учётки сохраните в docs/TEST_CREDENTIALS.local.md (не в git)

# E2E (Playwright) — опционально, только локально / CI secrets
# E2E_INVITE_CODE=""
# E2E_CHAIR_EMAIL=""
# E2E_CHAIR_PASSWORD=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# APK для кнопки «Скачать приложение» (после сборки: npm run upload:apk)
# NEXT_PUBLIC_APK_URL="https://pub-....r2.dev/releases/happylife.apk"

# Firebase Cloud Messaging (push в APK) — JSON сервисного аккаунта одной строкой
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...",...}'
# Публичный URL сайта для deep link в push (обычно = прод)
# NEXT_PUBLIC_APP_URL="https://happylife.estate"
# Native push in APK: only true after google-services.json is in mobile/android/app/
# NEXT_PUBLIC_ENABLE_NATIVE_PUSH=true
